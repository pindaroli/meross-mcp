# ==============================================================================
# Meross Dual Gateway (MCP + REST) - Environment Configuration
# ==============================================================================

# Meross Cloud Account Credentials (Obbligatorie)
MEROSS_EMAIL=your_email@example.com
MEROSS_PASSWORD=your_meross_cloud_password

# Meross Cloud API Endpoint Region (Opzionale, default: https://iotx-eu.meross.com)
# Europe:        https://iotx-eu.meross.com
# US / Americas: https://iotx-us.meross.com
# Asia-Pacific:  https://iotx-ap.meross.com
MEROSS_API_BASE_URL=https://iotx-eu.meross.com

# Server Gateway Settings
MEROSS_GATEWAY_HOST=0.0.0.0
MEROSS_GATEWAY_PORT=8112

# Optional REST API Key Protection (Lasciare vuoto se non richiesta autenticazione)
# Se configurata, le chiamate REST mutative (POST) richiederanno l'header X-API-Key
MEROSS_GATEWAY_API_KEY=
